{
  "permissions": {
    "allow": [
      "Bash(curl -s \"http://localhost:5174/src/index.css\")",
      "Bash(xargs cat)",
      "Bash(python3 -c ' *)",
      "Bash(python3 -)",
      "Bash(git check-ignore *)",
      "Bash(git status *)"
    ],
    "additionalDirectories": [
      "/Users/danny/Desktop/dev/toy/checkin/scripts"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && npx prettier --write --ignore-unknown \"$f\" >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-claude-md.sh"
          }
        ]
      }
    ]
  }
}
